{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/vote2026",
      "destination": "/vote/vote2026/vote2026.html"
    },
    {
      "source": "/vote2026/confirm",
      "destination": "/vote/vote2026/vote2026.html"
    },
    {
      "source": "/vote2026/thanks",
      "destination": "/vote/vote2026/vote2026.html"
    },
    {
      "source": "/result2026",
      "destination": "/vote/result2026.html"
    },
    {
      "source": "/games/matsu-quiz",
      "destination": "/games/matsu-quiz/matsu-quiz.html"
    },
    {
      "source": "/games/matsu-quiz/play",
      "destination": "/games/matsu-quiz/matsu-quiz.html"
    }
  ],
  "headers": [
    {
      "source": "/vote/vote2026/close2026.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ]
}
